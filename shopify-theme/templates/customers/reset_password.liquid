<section class="iv-wrap iv-sec iv-prose">
  <h1>Reset password</h1>
  {% form 'reset_customer_password' %}
    <label class="iv-input-label">New password</label><input class="iv-field" type="password" name="customer[password]">
    <label class="iv-input-label">Confirm</label><input class="iv-field" type="password" name="customer[password_confirmation]">
    <button class="iv-btn iv-btn-primary" type="submit">Reset</button>
  {% endform %}
</section>
