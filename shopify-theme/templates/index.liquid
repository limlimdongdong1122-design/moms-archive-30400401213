<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
.iv-promo *{box-sizing:border-box;margin:0;padding:0}
.iv-promo{--bg:#080b11;--bg2:#0c121b;--text:#eaf1fb;--dim:#9fb0c6;--faint:#6c7c93;--accent:#6ea8ff;--accent2:#a9cbff;--warn:#ffb454;--glass:rgba(255,255,255,.05);--glass-bd:rgba(255,255,255,.1);--r:18px;
  position:relative;overflow:hidden;isolation:isolate;color:var(--text);
  font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.65;border-radius:var(--r);
  background:linear-gradient(180deg,var(--bg),var(--bg2))}
/* animated background orbs */
.iv-promo .iv-orb{position:absolute;border-radius:50%;filter:blur(70px);z-index:0;pointer-events:none;opacity:.55}
.iv-promo .iv-orb.a{width:620px;height:620px;top:-180px;right:-140px;background:radial-gradient(circle,rgba(110,168,255,.5),transparent 65%);animation:ivfloat 16s ease-in-out infinite}
.iv-promo .iv-orb.b{width:520px;height:520px;bottom:-160px;left:-160px;background:radial-gradient(circle,rgba(110,168,255,.3),transparent 65%);animation:ivfloat 22s ease-in-out infinite reverse}
.iv-promo .iv-orb.c{width:360px;height:360px;top:38%;left:46%;background:radial-gradient(circle,rgba(169,203,255,.18),transparent 70%);animation:ivfloat 19s ease-in-out infinite}
@keyframes ivfloat{0%,100%{transform:translate(0,0)}50%{transform:translate(30px,-36px)}}
.iv-promo .iv-wrap{max-width:1120px;margin:0 auto;padding:0 clamp(20px,5vw,48px);position:relative;z-index:1}
.iv-promo .iv-sec{padding:clamp(54px,8vw,108px) 0;position:relative;z-index:1}
.iv-promo .iv-center{text-align:center}
.iv-promo h1{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(34px,6vw,64px);line-height:1.03;letter-spacing:-.025em;margin-bottom:20px;
  background:linear-gradient(180deg,#fff,#acc6f5);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 4px 30px rgba(110,168,255,.25))}
.iv-promo h2{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(27px,4.4vw,44px);line-height:1.08;letter-spacing:-.02em;
  background:linear-gradient(180deg,#fff,#c4d6f3);-webkit-background-clip:text;background-clip:text;color:transparent}
.iv-promo h3{font-family:'Space Grotesk',sans-serif;font-size:19px;margin-bottom:8px}
.iv-promo p{color:var(--dim)}
.iv-promo .iv-lead{font-size:clamp(16px,2.1vw,20px);max-width:560px}
.iv-promo .iv-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent2);font-weight:600;
  padding:8px 16px;border:1px solid rgba(110,168,255,.3);border-radius:999px;background:rgba(110,168,255,.06);margin-bottom:22px}
.iv-promo .iv-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px var(--accent);animation:ivpulse 2.4s ease-in-out infinite}
@keyframes ivpulse{0%,100%{opacity:.5}50%{opacity:1}}
.iv-promo .iv-cta{display:flex;flex-wrap:wrap;gap:14px;margin-top:30px}
.iv-promo .iv-center .iv-cta{justify-content:center}
.iv-promo a.iv-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:16px;padding:16px 30px;border-radius:14px;transition:transform .2s ease,box-shadow .2s ease}
.iv-promo a.iv-btn-primary{background:linear-gradient(180deg,var(--accent2),var(--accent));color:#06101f;box-shadow:0 10px 34px rgba(110,168,255,.4)}
.iv-promo a.iv-btn-primary:hover{transform:translateY(-3px);box-shadow:0 18px 50px rgba(110,168,255,.6)}
.iv-promo a.iv-btn-ghost{background:var(--glass);color:var(--text);border:1px solid var(--glass-bd)}
.iv-promo a.iv-btn-ghost:hover{transform:translateY(-3px);border-color:var(--accent)}
.iv-promo .iv-note{font-size:13px;color:var(--faint);margin-top:14px}
.iv-promo .iv-split{display:grid;grid-template-columns:1.02fr .98fr;gap:54px;align-items:center}
.iv-promo .iv-shotwrap{position:relative}
.iv-promo .iv-shotwrap::before{content:"";position:absolute;inset:-8% -6% -10% -6%;background:radial-gradient(closest-side,rgba(110,168,255,.35),transparent 75%);filter:blur(20px);z-index:0}
.iv-promo .iv-shot{position:relative;z-index:1;border-radius:var(--r);overflow:hidden;border:1px solid var(--glass-bd);box-shadow:0 30px 80px rgba(0,0,0,.55)}
.iv-promo .iv-float{animation:ivbob 7s ease-in-out infinite}
@keyframes ivbob{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.iv-promo .iv-svg{display:block;width:100%;height:auto}
/* trust stat band */
.iv-promo .iv-stats{display:flex;flex-wrap:wrap;justify-content:center;gap:0;border:1px solid var(--glass-bd);border-radius:var(--r);background:rgba(255,255,255,.03);overflow:hidden}
.iv-promo .iv-stat{flex:1;min-width:150px;padding:26px 18px;text-align:center;border-left:1px solid var(--glass-bd)}
.iv-promo .iv-stat:first-child{border-left:none}
.iv-promo .iv-stat b{display:block;font-family:'Space Grotesk',sans-serif;font-size:30px;font-weight:700;color:#fff}
.iv-promo .iv-stat span{font-size:13px;color:var(--faint);letter-spacing:.04em}
/* quote band */
.iv-promo .iv-quote{text-align:center;max-width:820px;margin:0 auto}
.iv-promo .iv-quote q{font-family:'Space Grotesk',sans-serif;font-size:clamp(22px,3.4vw,34px);font-weight:600;line-height:1.3;color:#dce7fb;quotes:none}
.iv-promo .iv-quote .iv-qsub{margin-top:18px;font-size:16px;color:var(--dim)}
.iv-promo .iv-quote .iv-qsub b{color:var(--accent2)}
/* cards */
.iv-promo .iv-g3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:42px}
.iv-promo .iv-card{position:relative;background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));border:1px solid var(--glass-bd);border-radius:var(--r);padding:30px 24px;transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease}
.iv-promo .iv-card:hover{transform:translateY(-6px);border-color:rgba(110,168,255,.5);box-shadow:0 20px 50px rgba(110,168,255,.16)}
.iv-promo .iv-ico{font-size:30px;display:inline-grid;place-items:center;width:58px;height:58px;border-radius:16px;margin-bottom:16px;background:rgba(110,168,255,.12);border:1px solid rgba(110,168,255,.25)}
.iv-promo .iv-card p{font-size:14.5px}
/* steps */
.iv-promo .iv-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:42px}
.iv-promo .iv-step{position:relative;padding-left:60px}
.iv-promo .iv-step .iv-num{position:absolute;left:0;top:0;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;color:#06101f;background:linear-gradient(180deg,var(--accent2),var(--accent));box-shadow:0 8px 24px rgba(110,168,255,.4)}
/* pricing */
.iv-promo .iv-g2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:42px;max-width:840px;margin-left:auto;margin-right:auto;text-align:left}
.iv-promo .iv-tier{position:relative;background:var(--glass);border:1px solid var(--glass-bd);border-radius:var(--r);padding:32px 30px}
.iv-promo .iv-tier.pro{border-color:rgba(110,168,255,.55);background:linear-gradient(180deg,rgba(110,168,255,.14),rgba(110,168,255,.03));box-shadow:0 16px 50px rgba(110,168,255,.22)}
.iv-promo .iv-best{position:absolute;top:-13px;right:22px;font-family:'Space Grotesk',sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;color:#06101f;background:linear-gradient(180deg,var(--accent2),var(--accent));padding:6px 12px;border-radius:999px}
.iv-promo .iv-tier h4{font-family:'Space Grotesk',sans-serif;font-size:14px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent2);margin-bottom:10px}
.iv-promo .iv-price{font-family:'Space Grotesk',sans-serif;font-size:38px;font-weight:700;color:#fff}
.iv-promo .iv-price small{font-size:15px;color:var(--faint);font-weight:500}
.iv-promo .iv-tier ul{list-style:none;margin-top:18px;display:grid;gap:11px}
.iv-promo .iv-tier li{font-size:14.5px;color:var(--dim);padding-left:24px;position:relative}
.iv-promo .iv-tier li::before{content:"\2713";position:absolute;left:0;color:var(--accent);font-weight:700}
/* privacy */
.iv-promo .iv-privacy{padding:28px;border-radius:var(--r);text-align:center;background:rgba(255,255,255,.03);border:1px solid var(--glass-bd)}
.iv-promo .iv-privacy b{color:var(--text)}
/* address */
.iv-promo .iv-address{display:inline-block;margin:20px auto 8px;padding:18px 40px;border-radius:20px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(28px,5.4vw,56px);text-decoration:none;color:#eaf3ff;
  background:linear-gradient(180deg,rgba(110,168,255,.18),rgba(110,168,255,.04));border:1px solid rgba(110,168,255,.5);text-shadow:0 0 28px rgba(110,168,255,.6);animation:ivglow 3.2s ease-in-out infinite}
@keyframes ivglow{0%,100%{box-shadow:0 12px 50px rgba(110,168,255,.28)}50%{box-shadow:0 18px 70px rgba(110,168,255,.55)}}
.iv-promo .iv-divider{height:1px;background:linear-gradient(90deg,transparent,var(--glass-bd),transparent);margin:0 auto;max-width:1120px}
@media(max-width:860px){.iv-promo .iv-split{grid-template-columns:1fr;gap:32px}.iv-promo .iv-g3,.iv-promo .iv-g2,.iv-promo .iv-steps{grid-template-columns:1fr}}
</style>

