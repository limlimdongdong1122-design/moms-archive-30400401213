{%- comment -%} IMPULSE VAULT — illustrated homepage. Change "impursivevault.com" and PayPal links if needed. {%- endcomment -%}
<div class="iv-promo">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap');
.iv-promo *{box-sizing:border-box;margin:0;padding:0}
.iv-promo{--bg:#0a0e14;--bg2:#0e141d;--text:#eaf1fb;--dim:#9fb0c6;--faint:#6c7c93;--accent:#6ea8ff;--accent2:#a9cbff;--warn:#ffb454;--glass:rgba(255,255,255,.05);--glass-bd:rgba(255,255,255,.1);--r:18px;
  position:relative;overflow:hidden;isolation:isolate;
  background:radial-gradient(1200px 600px at 85% -8%,rgba(110,168,255,.16),transparent 60%),radial-gradient(900px 520px at -5% 108%,rgba(110,168,255,.08),transparent 55%),linear-gradient(180deg,var(--bg),var(--bg2));
  color:var(--text);font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.65;border-radius:var(--r)}
.iv-promo .iv-wrap{max-width:1080px;margin:0 auto;padding:0 clamp(20px,5vw,48px)}
.iv-promo .iv-sec{padding:clamp(48px,7vw,92px) 0}
.iv-promo .iv-center{text-align:center}
.iv-promo h1{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(32px,5.5vw,56px);line-height:1.05;letter-spacing:-.02em;margin-bottom:18px;background:linear-gradient(180deg,#fff,#bcd2f3);-webkit-background-clip:text;background-clip:text;color:transparent}
.iv-promo h2{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(26px,4.2vw,40px);line-height:1.1;letter-spacing:-.02em;background:linear-gradient(180deg,#fff,#c4d6f3);-webkit-background-clip:text;background-clip:text;color:transparent}
.iv-promo h3{font-family:'Space Grotesk',sans-serif;font-size:19px;margin-bottom:8px}
.iv-promo p{color:var(--dim)}
.iv-promo .iv-lead{font-size:clamp(16px,2.1vw,20px);max-width:560px}
.iv-promo .iv-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent2);font-weight:600;padding:7px 14px;border:1px solid var(--glass-bd);border-radius:999px;background:var(--glass);margin-bottom:22px}
.iv-promo .iv-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px var(--accent)}
.iv-promo .iv-cta{display:flex;flex-wrap:wrap;gap:14px;margin-top:28px}
.iv-promo .iv-center .iv-cta{justify-content:center}
.iv-promo a.iv-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:16px;padding:15px 28px;border-radius:14px;transition:transform .18s ease,box-shadow .18s ease}
.iv-promo a.iv-btn-primary{background:linear-gradient(180deg,var(--accent2),var(--accent));color:#06101f;box-shadow:0 8px 30px rgba(110,168,255,.35)}
.iv-promo a.iv-btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 44px rgba(110,168,255,.5)}
.iv-promo a.iv-btn-ghost{background:var(--glass);color:var(--text);border:1px solid var(--glass-bd)}
.iv-promo a.iv-btn-ghost:hover{transform:translateY(-2px);border-color:var(--accent)}
.iv-promo .iv-note{font-size:13px;color:var(--faint);margin-top:14px}
.iv-promo .iv-split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.iv-promo .iv-shot{border-radius:var(--r);overflow:hidden;border:1px solid var(--glass-bd);box-shadow:0 24px 70px rgba(0,0,0,.5)}
.iv-promo .iv-svg{display:block;width:100%;height:auto}
.iv-promo .iv-g3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:40px}
.iv-promo .iv-card{background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));border:1px solid var(--glass-bd);border-radius:var(--r);padding:26px 22px}
.iv-promo .iv-ico{font-size:28px;display:block;margin-bottom:12px}
.iv-promo .iv-card p{font-size:14.5px}
.iv-promo .iv-g2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:40px}
.iv-promo .iv-tier{background:var(--glass);border:1px solid var(--glass-bd);border-radius:var(--r);padding:30px 28px}
.iv-promo .iv-tier.pro{border-color:rgba(110,168,255,.5);background:linear-gradient(180deg,rgba(110,168,255,.13),rgba(110,168,255,.03));box-shadow:0 12px 44px rgba(110,168,255,.2)}
.iv-promo .iv-tier h4{font-family:'Space Grotesk',sans-serif;font-size:14px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent2);margin-bottom:10px}
.iv-promo .iv-price{font-family:'Space Grotesk',sans-serif;font-size:34px;font-weight:700;color:#fff}
.iv-promo .iv-price small{font-size:15px;color:var(--faint);font-weight:500}
.iv-promo .iv-tier ul{list-style:none;margin-top:16px;display:grid;gap:10px}
.iv-promo .iv-tier li{font-size:14.5px;color:var(--dim);padding-left:22px;position:relative}
.iv-promo .iv-tier li::before{content:"\2713";position:absolute;left:0;color:var(--accent);font-weight:700}
.iv-promo .iv-privacy{padding:24px;border-radius:var(--r);text-align:center;background:var(--glass);border:1px solid var(--glass-bd)}
.iv-promo .iv-privacy b{color:var(--text)}
.iv-promo .iv-address{display:inline-block;margin:18px auto 8px;padding:16px 34px;border-radius:18px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(26px,5vw,50px);text-decoration:none;color:#eaf3ff;background:linear-gradient(180deg,rgba(110,168,255,.16),rgba(110,168,255,.04));border:1px solid rgba(110,168,255,.5);box-shadow:0 12px 50px rgba(110,168,255,.28);text-shadow:0 0 26px rgba(110,168,255,.55)}
.iv-promo .iv-cap{font-size:13px;color:var(--faint);text-align:center;margin-top:14px}
@media(max-width:860px){.iv-promo .iv-split{grid-template-columns:1fr;gap:30px}.iv-promo .iv-g3,.iv-promo .iv-g2{grid-template-columns:1fr}}
</style>

